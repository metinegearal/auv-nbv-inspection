<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_stereo_depth</name>
  <version>0.0.0</version>
  <description>Stereo depth estimation with BGNet. Apache-2.0 applies to project-authored code only; BGNet and model-weight terms remain unverified. See the repository-root THIRD_PARTY_NOTICES.md.</description>
  <maintainer email="metinegearal@gmail.com">metin-ege</maintainer>
  <license>Apache-2.0</license>
  <!-- BGNet and model weights are excluded; their terms remain unverified. -->

  <exec_depend>message_filters</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>auv_contracts</exec_depend>
  <exec_depend>auv_telemetry</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-torch</exec_depend>
  <exec_depend>python3-torchvision</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
